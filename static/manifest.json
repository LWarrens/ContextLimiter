{
	"name": "Context Limiter",
	"description": "Manage tab limits based on filters and window counts",
	"version": "0.0.1",
	"manifest_version": 3,
	"permissions": [
		"tabs",
		"windows",
		"storage",
		"activeTab"
	],
	"icons": {
		"32": "favicon.png"
	},
	"action": {
		"default_popup": "index.html",
		"default_icon": "favicon.png",
		"default_title": "Context Limiter"
	},
	"background": {
		"service_worker": "service-worker.js"
	}
}